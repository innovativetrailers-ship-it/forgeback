{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && npm run build",
  "installCommand": "npm install",

  "functions": {
    "src/app/api/upload/**": { "maxDuration": 120 },
    "src/app/api/jobs/create/route": { "maxDuration": 300 },
    "src/app/api/jobs/[jobId]/stream/route": { "maxDuration": 300 },
    "src/app/api/jobs/[jobId]/progress/route": { "maxDuration": 300 },
    "src/app/api/generate/route.ts": { "maxDuration": 300 },
    "src/app/api/generate/estimate/route.ts": { "maxDuration": 15 },
    "src/app/api/jobs/[jobId]/status/route.ts": { "maxDuration": 10 },
    "src/app/api/jobs/[jobId]/playback/route.ts": { "maxDuration": 60 },
    "src/app/api/swarm/**": { "maxDuration": 300 },
    "src/app/api/studio/compositor/render/route": { "maxDuration": 120 },
    "src/app/api/studio/director/route": { "maxDuration": 120 },
    "src/app/api/studio/continuity/route": { "maxDuration": 90 },
    "src/app/api/studio/storyboard/route": { "maxDuration": 90 },
    "src/app/api/timeline/render/route": { "maxDuration": 300 },
    "src/app/api/cgi/insert/route": { "maxDuration": 180 },
    "src/app/api/audio/**": { "maxDuration": 120 },
    "src/app/api/webhooks/**": { "maxDuration": 30 }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; frame-ancestors 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],

  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },

  "crons": [
    {
      "path": "/api/cron/cleanup-jobs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-rlhf",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/internal-audit",
      "schedule": "30 4 * * *"
    }
  ]
}
